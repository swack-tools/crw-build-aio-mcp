# Copied to .env on first use; empty secrets are generated then.

# Where crw listens on the host. `just up-stealth` offers the next free port
# if this one is taken, and saves the choice here.
CRW_HOST_PORT=3000
CRW_BIND_ADDRESS=127.0.0.1

SEARXNG_SECRET_KEY=

# chrome-stealth's shared memory and memory limit (uncomment to raise them for
# a page that crashes a tab or runs out of memory)
# CHROME_SHM_SIZE=512m
# CHROME_MEM_LIMIT=1536m

# Give Chrome WebGL (Mesa's software renderer) for pages that need it, such as
# iphey.com's test. Akamai flags that renderer as a virtual machine, so leave
# it off unless you need it. A page can also ask for renderer: camoufox, which
# spoofs WebGL.
# CHROME_WEBGL=on

# camofox's shared memory and memory limit (uncomment to raise them for a page
# that crashes a tab or runs out of memory)
# CAMOFOX_SHM_SIZE=1g
# CAMOFOX_MEM_LIMIT=2g

# Build knobs (uncomment to use)
# CAMOUFOX_REF=v152.0.4-beta.28   # build a Camoufox tag instead of main; then `just update`
# REGISTRY=docker.io/you/         # for `just push` (trailing slash)
# CAMOUFOX_DIST_REGISTRY=docker.io/swackhamer/   # fetch the CI-built Camoufox for these sources instead of compiling (defaults to REGISTRY)
# TAG=local
# CRW_HOME=/path/to/dir           # where the upstream clones and Camoufox zips live (default ~/.crw; a full path)
# SRC_CRW=/path/to/crw            # use an existing checkout for any source (SRC_<NAME>)
