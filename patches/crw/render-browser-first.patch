+/// Does this URL's path name a file a browser downloads or shows in a viewer
+/// rather than renders: a PDF, an office document, an archive, an image or
+/// media? The forced-JS arm sends these to HTTP without a browser.
+fn url_path_is_file(url: &str) -> bool {
+    const EXTENSIONS: &[&str] = &[
+        "pdf", "doc", "docx", "xls", "xlsx", "ppt", "pptx", "odt", "ods", "odp", "rtf", "epub",
+        "csv", "zip", "gz", "tgz", "tar", "7z", "rar", "png", "jpg", "jpeg", "gif", "webp", "avif",
+        "bmp", "ico", "mp3", "m4a", "wav", "ogg", "mp4", "webm", "mov", "avi",
+    ];
+    url::Url::parse(url).is_ok_and(|u| {
+        let path = u.path().to_ascii_lowercase();
+        path.rsplit_once('.')
+            .is_some_and(|(_, ext)| EXTENSIONS.contains(&ext))
+    })
+}
