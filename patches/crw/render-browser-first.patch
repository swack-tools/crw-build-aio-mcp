+/// A named vendor's block page in `result`, as a verdict: the vendor markers
+/// `detector` matches, or a block `antibot::classify` names from the body
+/// alone. Not from the status: a 403 can carry the real page. Nor its
+/// structural "thin page" verdict, which is not a wall.
+fn vendor_wall(result: &FetchResult) -> Option<crw_core::types::BlockOutcome> {
+    if let Some(vendor) = detector::looks_like_vendor_block(&result.html) {
+        return Some(crw_core::types::BlockOutcome {
+            vendor: vendor.to_string(),
+            reason: format!("{vendor} anti-bot wall that no renderer tier could clear"),
+        });
+    }
+    let r = crw_extract::antibot::classify(None, &result.html);
+    (r.signal.is_blocked() && r.signal != crw_extract::antibot::AntibotSignal::StructuralFailure)
+        .then(|| crw_core::types::BlockOutcome {
+            vendor: r.signal.class_name().to_string(),
+            reason: r.reason,
+        })
+}
+
+/// Is this body a wall, by the generic phrase list or a vendor's markers? A
+/// fallback body that is one must not stand in for a walled ladder result.
+fn is_wall(result: &FetchResult) -> bool {
+    detector::looks_like_generic_bot_wall(&result.html, result.truncated)
+        || vendor_wall(result).is_some()
+}
