+/// Deserializer for an optional bool that also accepts `"auto"`, an empty
+/// string or a whitespace-only string as `None`, and `"true"`/`"false"` as
+/// strings (an env value `try_parsing` didn't turn into a bool).
+///
+/// Applied via `#[serde(default, deserialize_with = ...)]`, so a missing key is
+/// `None` from `Default` and only a present value reaches this function.
+fn deserialize_opt_bool_or_auto<'de, D>(deserializer: D) -> Result<Option<bool>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+{
+    #[derive(Deserialize)]
+    #[serde(untagged)]
+    enum BoolOrString {
+        Bool(bool),
+        Str(String),
+    }
+    match BoolOrString::deserialize(deserializer)? {
+        BoolOrString::Bool(b) => Ok(Some(b)),
+        BoolOrString::Str(s) => match s.trim().to_ascii_lowercase().as_str() {
+            "" | "auto" => Ok(None),
+            "true" => Ok(Some(true)),
+            "false" => Ok(Some(false)),
+            other => Err(serde::de::Error::custom(format!(
+                "render_js_default: expected true, false or \"auto\", got {other:?}"
+            ))),
+        },
+    }
+}
