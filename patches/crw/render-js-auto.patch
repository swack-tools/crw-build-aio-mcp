+    /// Auto mode (no `renderJs`): a named vendor's wall that HTTP gets with a
+    /// 200 goes to the browser instead of coming back as the page.
+    #[tokio::test]
+    async fn auto_vendor_wall_200_goes_to_browser() {
+        let akamai = "<html><body><h1>adidas</h1>\
+                      <p>Reference Error: 0.333b2f17.1793287426.7e59a54</p></body></html>";
+        let article = format!(
+            "<html><body><article><h1>Real page</h1><p>{}</p></article></body></html>",
+            "Genuine prose that no detector could mistake for an interstitial. ".repeat(20)
+        );
+        let chrome = Arc::new(MockFetcher {
+            name: "chrome",
+            behavior: MockBehavior::Ok(article),
+        }) as Arc<dyn PageFetcher>;
+        let mut r = make_renderer_with_mocks(vec![chrome]);
+        let http = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        r.http = Arc::new(CountingBody {
+            calls: http.clone(),
+            body: akamai.to_string(),
+        });
+        let out = r
+            .fetch("https://example.com", &HashMap::new(), None, None, None, tdl())
+            .await
+            .expect("the browser's page");
+        assert_eq!(http.load(std::sync::atomic::Ordering::SeqCst), 1);
+        assert!(out.html.contains("Real page"), "{}", out.html);
+    }
