+    /// The HTTP status of the document now in the page, if it can be read.
+    async fn document_status(conn: &CdpConnection, session_id: &str) -> Option<u16> {
+        conn.send_recv(
+            "Runtime.evaluate",
+            serde_json::json!({
+                "expression": "performance.getEntriesByType('navigation')[0]?.responseStatus || 0",
+                "returnByValue": true,
+            }),
+            Some(session_id),
+            Duration::from_secs(2),
+        )
+        .await
+        .ok()
+        .and_then(|v| v.pointer("/result/value").and_then(|s| s.as_u64()))
+        .and_then(|s| u16::try_from(s).ok())
+        .filter(|s| *s != 0)
+    }
+
+    /// Poll a challenge page until it clears or the retries run out; any other
+    /// page comes straight back.
+    async fn wait_out_challenge(
+        &self,
+        conn: &CdpConnection,
+        session_id: &str,
+        url: &str,
+        mut html: String,
+    ) -> CrwResult<String> {
+        if self.challenge_max_retries == 0 || !is_challenge_page(&html) {
+            return Ok(html);
+        }
+        tracing::info!(
+            url = %LogUrl(&url),
+            "Challenge page detected, waiting for auto-resolve",
+        );
+        for attempt in 1..=self.challenge_max_retries {
+            tokio::time::sleep(Duration::from_millis(CHALLENGE_POLL_INTERVAL_MS)).await;
+            html = Self::eval_html(conn, session_id, self.page_timeout).await?;
+            if !is_challenge_page(&html) {
+                tracing::info!(url = %LogUrl(&url), attempt, "Challenge cleared");
+                break;
+            }
+            tracing::debug!(url = %LogUrl(&url), attempt, "Challenge still active, retrying");
+        }
+        Ok(html)
+    }
+
+    /// Reload the page, wait for the new document to load and the network to
+    /// settle, and read it.
+    async fn reload_and_read(
+        &self,
+        conn: &CdpConnection,
+        session_id: &str,
+        net: &NetworkActivityTracker,
+    ) -> CrwResult<String> {
+        const DOCUMENT: &str = "JSON.stringify([performance.timeOrigin, document.readyState])";
+        let document = || async {
+            conn.send_recv(
+                "Runtime.evaluate",
+                serde_json::json!({ "expression": DOCUMENT, "returnByValue": true }),
+                Some(session_id),
+                Duration::from_secs(2),
+            )
+            .await
+            .ok()
+            .and_then(|v| {
+                v.pointer("/result/value")
+                    .and_then(|s| s.as_str())
+                    .map(str::to_owned)
+            })
+            .and_then(|s| serde_json::from_str::<(f64, String)>(&s).ok())
+        };
+        let before = document().await.map(|(origin, _)| origin);
+        conn.send_recv(
+            "Page.reload",
+            serde_json::json!({}),
+            Some(session_id),
+            self.page_timeout,
+        )
+        .await?;
+        // A new document has a new time origin; wait for it to finish loading.
+        let loaded_by = Instant::now() + RELOAD_LOAD_MAX;
+        while Instant::now() < loaded_by {
+            tokio::time::sleep(Duration::from_millis(SPA_SELECTOR_TICK_MS)).await;
+            if let Some((origin, state)) = document().await
+                && Some(origin) != before
+                && state == "complete"
+            {
+                break;
+            }
+        }
+        let settle_end = Instant::now() + Duration::from_millis(SETTLE_MAX_MS);
+        tokio::time::sleep(Duration::from_millis(SETTLE_MIN_MS)).await;
+        while Instant::now() < settle_end
+            && !net.is_settled(SETTLE_QUIET_MS, ALMOST_IDLE_MAX_INFLIGHT)
+        {
+            tokio::time::sleep(Duration::from_millis(SPA_SELECTOR_TICK_MS)).await;
+        }
+        Self::eval_html(conn, session_id, self.page_timeout).await
+    }
