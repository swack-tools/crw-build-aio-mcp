+/// Did the page turn this visit away with a wall a reload may clear? A
+/// generic or vendor block page, but not a challenge still solving itself.
+fn is_revisitable_wall(html: &str) -> bool {
+    if is_challenge_page(html) {
+        return false;
+    }
+    let named = crw_extract::antibot::classify(None, html);
+    crate::detector::looks_like_generic_bot_wall(html, false)
+        || crate::detector::looks_like_vendor_block(html).is_some()
+        || (named.signal.is_blocked()
+            && named.signal != crw_extract::antibot::AntibotSignal::StructuralFailure)
+}
