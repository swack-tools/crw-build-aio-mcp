+/// Did the page turn this visit away with a wall a reload may clear? A
+/// generic or vendor block page, or one only its status marks as a block, but
+/// not a challenge still solving itself. A 429 asks for fewer requests, so it
+/// doesn't count on its status alone.
+fn is_revisitable_wall(status: Option<u16>, html: &str) -> bool {
+    if is_challenge_page(html) {
+        return false;
+    }
+    let named = crw_extract::antibot::classify(status.filter(|s| *s != 429), html);
+    crate::detector::looks_like_generic_bot_wall(html, false)
+        || crate::detector::looks_like_vendor_block(html).is_some()
+        || (named.signal.is_blocked()
+            && named.signal != crw_extract::antibot::AntibotSignal::StructuralFailure)
+}
