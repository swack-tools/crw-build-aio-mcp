+    #[test]
+    fn revisitable_walls() {
+        assert!(is_revisitable_wall(
+            Some(200),
+            "<html><head><title>Reddit - Prove your humanity</title></head><body><h1>Prove your humanity</h1></body></html>"
+        ));
+        assert!(is_revisitable_wall(
+            None,
+            "<html><head><title>Error Page</title></head><body><main><div>Oops!! Something went wrong. Please refresh page</div></main></body></html>"
+        ));
+        // A challenge solves itself; the loop waits for it instead.
+        assert!(!is_revisitable_wall(
+            Some(403),
+            "<html><head><title>Just a moment...</title></head></html>"
+        ));
+        assert!(!is_revisitable_wall(
+            Some(200),
+            "<html><head><title>Example</title></head><body><article><p>A page that loaded.</p></article></body></html>"
+        ));
+        // eBay's first answer to a fresh profile: only the status says block.
+        let ebay = "<html><head><title>Error Page | eBay</title></head><body><main><h1>SORRY</h1><p>Something went wrong on our end</p><p>0.2a3b2f17.1793488708.1f6693c8</p><p>Please go back and try again.</p></main></body></html>";
+        assert!(is_revisitable_wall(Some(403), ebay));
+        assert!(!is_revisitable_wall(Some(200), ebay));
+        assert!(!is_revisitable_wall(Some(404), ebay));
+        // Rate limited: another request right away won't help.
+        assert!(!is_revisitable_wall(Some(429), ebay));
+    }
