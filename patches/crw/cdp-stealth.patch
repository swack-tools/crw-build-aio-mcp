+/// Whether Chrome's requests are paused and checked against private network
+/// ranges (`CRW_RENDERER__CHROME_OUTBOUND_CHECK`, default on). Off, a page's
+/// requests go straight out, as in a person's browser; Chrome's own Local
+/// Network Access still asks before a public page reaches a private address.
+/// The check breaks some anti-bot scripts: Kasada's (hyatt.com) clears one
+/// cold visit in four with it and every one without.
+fn chrome_outbound_check() -> bool {
+    std::env::var("CRW_RENDERER__CHROME_OUTBOUND_CHECK")
+        .map(|v| !v.trim().eq_ignore_ascii_case("false"))
+        .unwrap_or(true)
+}
