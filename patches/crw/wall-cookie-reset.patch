+    /// The URL of the document now in the page, past any redirect, if it can
+    /// be read.
+    async fn document_url(conn: &CdpConnection, session_id: &str) -> Option<String> {
+        conn.send_recv(
+            "Runtime.evaluate",
+            serde_json::json!({ "expression": "location.href", "returnByValue": true }),
+            Some(session_id),
+            Duration::from_secs(2),
+        )
+        .await
+        .ok()
+        .and_then(|v| v.pointer("/result/value")?.as_str().map(str::to_owned))
+        .filter(|u| u.starts_with("http"))
+    }
+
+    /// Whether `url`'s host may have its data dropped now (`wall_reset_due`).
+    fn wall_reset_due_for(&self, url: &str) -> bool {
+        let Some(host) = url::Url::parse(url)
+            .ok()
+            .and_then(|u| u.host_str().map(str::to_owned))
+        else {
+            return false;
+        };
+        let mut resets = self.wall_resets.lock().unwrap_or_else(|e| e.into_inner());
+        wall_reset_due(&mut resets, &host, Instant::now())
+    }
+
+    /// Whether to close the browser for a fresh profile now: when asked to,
+    /// and not within `BROWSER_RESTART_COOLDOWN` of the last time.
+    fn browser_restart_due_now(&self) -> bool {
+        self.restart_on_walled_reset
+            && browser_restart_due(
