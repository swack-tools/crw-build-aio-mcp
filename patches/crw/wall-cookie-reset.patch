+    #[test]
+    fn wall_reset_once_per_host_per_cooldown() {
+        use super::{CdpRenderer, WALL_RESET_COOLDOWN, wall_reset_due};
+        use std::collections::HashMap;
+        use std::time::{Duration, Instant};
+        use super::{WALL_BURST_WINDOW, WallReset::*};
+        let mut resets = HashMap::new();
+        let t0 = Instant::now();
+        assert_eq!(wall_reset_due(&mut resets, "www.ebay.com", t0), Due);
+        assert_eq!(wall_reset_due(&mut resets, "www.ebay.com", t0 + Duration::from_secs(1)), NotDue);
+        assert_eq!(wall_reset_due(&mut resets, "www.reddit.com", t0 + Duration::from_secs(1)), Due);
+        // A second drop within the window is a burst; past it, a first drop again.
+        assert_eq!(wall_reset_due(&mut resets, "www.ebay.com", t0 + WALL_RESET_COOLDOWN), Burst);
+        assert_eq!(resets.len(), 2);
+        let later = t0 + WALL_RESET_COOLDOWN + WALL_BURST_WINDOW;
+        assert_eq!(wall_reset_due(&mut resets, "www.ebay.com", later), Due);
+        assert_eq!(resets.len(), 1);
+        let r = CdpRenderer::new("chrome", "ws://x/", 1000, 1);
+        assert_eq!(r.wall_reset_due_for("https://www.ebay.com/itm/1"), Due);
+        assert_eq!(r.wall_reset_due_for("https://www.ebay.com/sch/i.html?_nkw=x"), NotDue);
+        assert_eq!(r.wall_reset_due_for("not a url"), NotDue);
+        // A browser close forgets the drops: the fresh profile's first wall
+        // gets a drop of its own, not the cooldown of the one before.
+        r.forget_wall_resets();
+        assert_eq!(r.wall_reset_due_for("https://www.ebay.com/itm/2"), Due);
+    }
