+/// Does this snapshot have a `<body>`? Chrome's parser gives every finished
+/// HTML document one, so a snapshot without it is of a document still being
+/// parsed: the page sent the reader on to another one.
+fn has_body(html: &str) -> bool {
+    html.contains("<body")
+}
+
+/// Whether `host`'s cookies and storage may be dropped now: when they weren't
+/// within `WALL_RESET_COOLDOWN`. Records the drop when so, and forgets hosts
+/// past the cooldown.
+fn wall_reset_due(resets: &mut HashMap<String, Instant>, host: &str, now: Instant) -> bool {
+    resets.retain(|_, at| now.saturating_duration_since(*at) < WALL_RESET_COOLDOWN);
+    if resets.contains_key(host) {
+        return false;
+    }
+    resets.insert(host.to_string(), now);
+    true
+}
+
+/// Whether the browser may be closed for a fresh profile now: when it wasn't
+/// within `BROWSER_RESTART_COOLDOWN`. Records the close when so.
+fn browser_restart_due(last: &mut Option<Instant>, now: Instant) -> bool {
+    if last.is_some_and(|at| now.saturating_duration_since(at) < BROWSER_RESTART_COOLDOWN) {
+        return false;
+    }
+    *last = Some(now);
+    true
+}
+
