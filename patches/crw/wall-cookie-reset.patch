+/// What a wall that outlasted the reload gets, by when the host's cookies
+/// were last dropped.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum WallReset {
+    /// Nothing: the last drop was within `WALL_RESET_COOLDOWN`.
+    NotDue,
+    /// The host's cookies and storage dropped, and a first visit.
+    Due,
+    /// A drop would be the second within `WALL_BURST_WINDOW`: the browser is
+    /// closed for a fresh profile instead.
+    Burst,
+}
+
+/// Whether `host`'s cookies and storage may be dropped now, and whether that
+/// would be the second drop within `WALL_BURST_WINDOW`. Records the drop when
+/// due, and forgets hosts past the window.
+fn wall_reset_due(resets: &mut HashMap<String, Instant>, host: &str, now: Instant) -> WallReset {
+    resets.retain(|_, at| now.saturating_duration_since(*at) < WALL_BURST_WINDOW);
+    let last = resets.get(host).copied();
+    if last.is_some_and(|at| now.saturating_duration_since(at) < WALL_RESET_COOLDOWN) {
+        return WallReset::NotDue;
+    }
+    resets.insert(host.to_string(), now);
+    if last.is_some() { WallReset::Burst } else { WallReset::Due }
+}
+
+/// Whether the browser may be closed for a fresh profile now: when it wasn't
+/// within `BROWSER_RESTART_COOLDOWN`. Records the close when so.
+fn browser_restart_due(last: &mut Option<Instant>, now: Instant) -> bool {
+    if last.is_some_and(|at| now.saturating_duration_since(at) < BROWSER_RESTART_COOLDOWN) {
+        return false;
+    }
+    *last = Some(now);
+    true
+}
