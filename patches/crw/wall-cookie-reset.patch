+    /// Whether `url`'s host may have its data dropped now (`wall_reset_due`).
+    fn wall_reset_due_for(&self, url: &str) -> bool {
+        let Some(host) = url::Url::parse(url)
+            .ok()
+            .and_then(|u| u.host_str().map(str::to_owned))
+        else {
+            return false;
+        };
+        let mut resets = self.wall_resets.lock().unwrap_or_else(|e| e.into_inner());
+        wall_reset_due(&mut resets, &host, Instant::now())
+    }
