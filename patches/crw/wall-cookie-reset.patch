+/// The status to report for a page read after a reload replaced the document
+/// the navigation reported on. `read` is the page's own status, which Chrome
+/// hides (reads 0) when the document came through a cross-origin redirect, as
+/// eBay sends a first visit. With it hidden, a document with more text than a
+/// wall carries and none of a wall's marks is the page, and the only status
+/// that fits a page is 200; the wall's 403 belonged to the document the reload
+/// replaced, and reporting it had the classifier fail three real eBay pages in
+/// a day. A small or marked body keeps the navigation's status (`None` here):
+/// eBay's own wall says nothing the detectors know, so its size tells.
+fn status_after_reload(read: Option<u16>, html: &str) -> Option<u16> {
+    match read {
+        Some(status) => Some(status),
+        None if !is_revisitable_wall(None, html)
+            && crate::detector::extract_body_text_len(&html.to_lowercase(), false)
+                > WALL_TEXT_MAX =>
+        {
+            Some(200)
+        }
+        None => None,
+    }
+}
