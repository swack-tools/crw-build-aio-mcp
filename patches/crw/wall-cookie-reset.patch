+    /// Drop the cookies `url` would be sent, and its origin's storage, so the
+    /// next visit is a first one. Best-effort; returns how many cookies went.
+    async fn clear_site_data(conn: &CdpConnection, session_id: &str, url: &str) -> usize {
+        let cookies = conn
+            .send_recv(
+                "Network.getCookies",
+                serde_json::json!({ "urls": [url] }),
+                Some(session_id),
+                Duration::from_secs(2),
+            )
+            .await
+            .ok();
+        let mut dropped = 0;
+        for c in cookies
+            .as_ref()
+            .and_then(|r| r.get("cookies"))
+            .and_then(|c| c.as_array())
+            .into_iter()
+            .flatten()
+        {
+            let (Some(name), Some(domain)) = (
+                c.get("name").and_then(|v| v.as_str()),
+                c.get("domain").and_then(|v| v.as_str()),
+            ) else {
+                continue;
+            };
+            let path = c.get("path").and_then(|v| v.as_str()).unwrap_or("/");
+            if conn
+                .send_recv(
+                    "Network.deleteCookies",
+                    serde_json::json!({ "name": name, "domain": domain, "path": path }),
+                    Some(session_id),
+                    Duration::from_secs(2),
+                )
+                .await
+                .is_ok()
+            {
+                dropped += 1;
+            }
+        }
+        // The wall is the site's own document, so its storage is in reach.
+        let _ = conn
+            .send_recv(
+                "Runtime.evaluate",
+                serde_json::json!({
+                    "expression": "try { sessionStorage.clear(); localStorage.clear(); } catch (e) {}",
+                    "returnByValue": true,
+                }),
+                Some(session_id),
+                Duration::from_secs(2),
+            )
+            .await;
+        if let Ok(origin) = url::Url::parse(url).map(|u| u.origin().ascii_serialization()) {
+            let _ = conn
+                .send_recv(
+                    "Storage.clearDataForOrigin",
+                    serde_json::json!({
+                        "origin": origin,
+                        "storageTypes": "local_storage,indexeddb,cache_storage,service_workers",
+                    }),
+                    Some(session_id),
+                    Duration::from_secs(5),
+                )
+                .await;
+        }
+        dropped
+    }
