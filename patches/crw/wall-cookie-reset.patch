+    #[test]
+    fn wall_reset_once_per_host_per_cooldown() {
+        use super::{CdpRenderer, WALL_RESET_COOLDOWN, wall_reset_due};
+        use std::collections::HashMap;
+        use std::time::{Duration, Instant};
+        let mut resets = HashMap::new();
+        let t0 = Instant::now();
+        assert!(wall_reset_due(&mut resets, "www.ebay.com", t0));
+        assert!(!wall_reset_due(&mut resets, "www.ebay.com", t0 + Duration::from_secs(1)));
+        assert!(wall_reset_due(&mut resets, "www.reddit.com", t0 + Duration::from_secs(1)));
+        assert!(wall_reset_due(&mut resets, "www.ebay.com", t0 + WALL_RESET_COOLDOWN));
+        assert_eq!(resets.len(), 2);
+        let r = CdpRenderer::new("chrome", "ws://x/", 1000, 1);
+        assert!(r.wall_reset_due_for("https://www.ebay.com/itm/1"));
+        assert!(!r.wall_reset_due_for("https://www.ebay.com/sch/i.html?_nkw=x"));
+        assert!(!r.wall_reset_due_for("not a url"));
+    }
