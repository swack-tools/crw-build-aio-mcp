+    /// The tracker keeps the main frame's last document status: a redirect's
+    /// or reload's response replaces the first, and an iframe's never counts.
+    #[tokio::test]
+    async fn tracker_keeps_the_main_frame_document_status() {
+        use super::{NetworkActivityTracker, run_network_idle_pump};
+        use crate::cdp_conn::CdpEvent;
+        let (tx, rx) = tokio::sync::broadcast::channel(16);
+        let tracker = std::sync::Arc::new(NetworkActivityTracker::new());
+        let t = tracker.clone();
+        let pump = tokio::spawn(async move { run_network_idle_pump(rx, t, "S1").await });
+        let ev = |method: &str, params: serde_json::Value| CdpEvent {
+            method: method.to_string(),
+            params,
+            session_id: Some("S1".to_string()),
+        };
+        assert_eq!(tracker.document_status(), None);
+        tx.send(ev("Network.requestWillBeSent", serde_json::json!({"requestId": "r1", "frameId": "F1", "type": "Document"}))).unwrap();
+        tx.send(ev("Network.responseReceived", serde_json::json!({"requestId": "r1", "frameId": "F1", "type": "Document", "response": {"status": 403}}))).unwrap();
+        tx.send(ev("Network.responseReceived", serde_json::json!({"requestId": "r2", "frameId": "F2", "type": "Document", "response": {"status": 404}}))).unwrap();
+        tx.send(ev("Network.responseReceived", serde_json::json!({"requestId": "r3", "frameId": "F1", "type": "Script", "response": {"status": 500}}))).unwrap();
+        for _ in 0..50 {
+            tokio::task::yield_now().await;
+        }
+        assert_eq!(tracker.document_status(), Some(403));
+        tx.send(ev("Network.responseReceived", serde_json::json!({"requestId": "r4", "frameId": "F1", "type": "Document", "response": {"status": 200}}))).unwrap();
+        for _ in 0..50 {
+            tokio::task::yield_now().await;
+        }
+        assert_eq!(tracker.document_status(), Some(200));
+        drop(tx);
+        let _ = pump.await;
+    }
