#!/usr/bin/env bash
# crw-aio — run the crw stealth stack and its MCP server, as installed from the
# crw-build-aio-mcp disk image (see install.sh there).
source "$(dirname "$(readlink -f "$0")")/../scripts/lib.sh"

usage() {
  cat <<EOF
usage: crw-aio <command>
  up                     start the stack (pulls the images on first run)
  down                   stop it
  update                 pull this release's images again and restart
  status                 list the containers
  logs [service...]      follow logs (crw, camofox, chrome-stealth, searxng)
  test                   scrape through each stealth tier, plus a bot-check report
  mcp install|uninstall [claude|codex|antigravity|all] [--dry-run] [--yes]
                         register the crw MCP server (shows the changes, asks first)
  uninstall              remove the MCP entries, the stack and $ROOT

crw listens on $(crw_url) (CRW_HOST_PORT in $ROOT/.env).
EOF
}

cmd="${1:-help}"
shift || true
case "$cmd" in
  up) exec "$ROOT/scripts/up.sh" ;;
  down) compose down ;;
  update) compose pull && exec "$ROOT/scripts/up.sh" ;;
  status) compose ps ;;
  logs) compose logs -f --tail=100 "$@" ;;
  test) exec "$ROOT/scripts/test-stealth.sh" ;;
  mcp)
    action="${1:-}"
    [[ "$action" == install || "$action" == uninstall ]] || { usage >&2; exit 1; }
    shift
    target=all
    if [[ "${1:-}" =~ ^(claude|codex|antigravity|all)$ ]]; then target="$1"; shift; fi
    exec "$ROOT/scripts/install-mcp.sh" "$action" "$target" "$@"
    ;;
  uninstall)
    # Only ever delete a directory that is an installed bundle.
    [[ -f "$ROOT/docker-compose.yml" && -x "$ROOT/bin/crw-aio" ]] || die "$ROOT does not look like a crw-aio install"
    [[ -t 0 ]] || die "no terminal to confirm on"
    read -r -p "Remove the crw MCP entries, stop the stack and delete $ROOT? [y/N] " answer
    [[ "$answer" =~ ^[Yy] ]] || die "aborted; nothing was changed"
    "$ROOT/scripts/install-mcp.sh" uninstall all --yes
    compose down --remove-orphans
    link="$HOME/.local/bin/crw-aio"
    [[ "$(readlink "$link" 2>/dev/null)" != "$ROOT/bin/crw-aio" ]] || rm -f "$link"
    images="$(compose config --images 2>/dev/null | tr '\n' ' ')"
    rm -rf "$ROOT"
    log "removed. The images are still in Docker; free the space with: docker image rm $images"
    ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
